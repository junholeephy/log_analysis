# 데이터 — 절대 올리지 않는다.
# .gitignore 는 `git add -f` 한 번에 뚫린다. 진짜 방어선은 "가짜 데이터를
# 파일로 두지 않는 것"이다 (src/ragdiag/fixtures/synth.py 가 런타임에 만든다).
*.csv
*.tsv
*.parquet
*.xlsx
*.pkl
*.npy
*.npz
*.h5
*.feather
*.sqlite*
*.jsonl
data/
outputs/
output/
logs/

# 입력·설정 예시 JSON, 원본 명세
*.json
!package.json
taxonomy*.txt

# 사내 실값
configs/local.yaml
configs/local.example.yaml
.env

# 이식 중계 clone (AA 쪽에서 쓰지만 여기서도 막아 둔다)
.staging/

# 노트북 로컬 탐색
notebooks/local/

# 실행 산출물
.cache/
results.jsonl

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# 도구
.omc/
.DS_Store
